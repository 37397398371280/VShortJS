      "require": "./shortjs.js",
      "default": "./shortjs.js"
    }
  },
  "files": [
    "shortjs.js",
    "docs.html",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "shortjs",
    "preprocessor",
    "shorthand",
    "javascript",
    "ecmascript",
    "source-map",
    "stack-trace",
    "compiler",
    "ast-free"
  ],

{
  "name": "nanojs",
  "version": "1.0.0",
  "description": "Ultra-lightweight, collision-aware JavaScript shorthand preprocessor with template interpolation, regex awareness, identifier protection, and stack-trace line remapping.",
  "main": "./nanojs.js",
  "module": "./nanojs.js",
  "exports": {
    ".": {
      "import": "./nanojs.js",
      "require": "./nanojs.js",
      "default": "./nanojs.js"
    }
  },
  "files": [
    "nanojs.js",
    "docs.html",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "shortjs",
    "preprocessor",
    "shorthand",
    "javascript",
    "ecmascript",
    "source-map",
    "stack-trace",
    "compiler",
    "ast-free"
  ],
  "license": "GPL-3.0"
}
